# ==========================================
# 1. 개인정보 및 카카오톡 대화 / 리포트 데이터
# ==========================================
# 카카오톡 대화 내보내기 원본 (개인정보 보호)
exports/*
!exports/.gitkeep

# 자동 생성되는 월간 출석/벌금 리포트
reports/*
!reports/.gitkeep

# 실제 모임 인원 및 오프라인 참석자 명단 (로컬 전용)
members.json
offline_attendance.json

# 예시 파일은 Git으로 관리
!members.example.json
!offline_attendance.example.json

# ==========================================
# 2. Python 및 가상환경
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/

# ==========================================
# 3. PyInstaller (.exe 패키징 산출물)
# ==========================================
build/
dist/
*.exe
*.spec

# ==========================================
# 4. IDE 및 OS 임시 파일
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db